# Karşılamada gösterilecek ad (isteğe bağlı). Boşsa yalnızca "Hoş geldin" yazılır.
# Yerelde .env.local dosyasına, yayında ise barındırma hizmetinin ortam değişkenlerine ekleyin.
VITE_RECIPIENT_NAME=

# Sitenin yayın adresi (isteğe bağlı). canonical, bağlantı önizlemesi, robots.txt ve sitemap.xml için kullanılır.
# Boşsa https://rengim.vercel.app varsayılır. Adres değişirse burayı güncelleyin.
VITE_SITE_URL=

# Google Search Console "HTML etiketi" doğrulama kodu (isteğe bağlı).
VITE_GOOGLE_SITE_VERIFICATION=
